/* 树树工作台 · 奶油色系设计系统 */
:root {
  --bg: #FDF9F5;
  --surface: #FFFCF9;
  --surface-2: #FFF6F1;

  --pink-1: #FCEDEA;
  --pink-2: #F7DED9;
  --pink-3: #EFC7C3;
  --pink-4: #E4ABA7;
  --pink-ink: #B97773;

  --yellow: #FBF0D5;
  --yellow-2: #F5E3B8;
  --blue: #DFEBEF;
  --blue-2: #C5DDE5;
  --green: #E3EDDC;
  --green-2: #C9DFBD;
  --lavender: #EAE2F0;

  --ink: #5A4F4A;
  --ink-2: #8E8078;
  --ink-3: #B4A69E;
  --line: #F0E6DF;

  --shadow: 0 6px 22px rgba(190, 160, 150, .13);
  --shadow-sm: 0 2px 10px rgba(190, 160, 150, .10);

  --radius: 22px;
  --radius-sm: 14px;

  --font-ui: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  --font-hand: "LXGW WenKai", "霞鹜文楷", "STKaiti", "KaiTi", "楷体", "Kaiti SC", "Noto Serif CJK SC", serif;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; padding: 0; height: 100%; }
body {
  font-family: var(--font-ui);
  color: var(--ink);
  background: var(--bg);
  background-image:
    radial-gradient(circle at 8% 4%, #FDEEEA 0, transparent 32%),
    radial-gradient(circle at 94% 92%, #EAF1E6 0, transparent 30%),
    radial-gradient(circle at 90% 6%, #FCF3DD 0, transparent 26%);
  font-size: 15px;
  line-height: 1.6;
  overflow: hidden;
}
button, input, textarea, select { font-family: inherit; font-size: inherit; color: inherit; }
button { cursor: pointer; border: none; background: none; }
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-thumb { background: #EADCD4; border-radius: 10px; }
::-webkit-scrollbar-track { background: transparent; }

/* ============ 应用骨架 ============ */
#app { display: flex; height: 100vh; width: 100%; }

.sidebar {
  width: 116px;
  flex: 0 0 116px;
  background: linear-gradient(180deg, #FFF9F5 0%, #FDF1EC 100%);
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18px 8px 14px;
  z-index: 20;
}
.brand { display: flex; flex-direction: column; align-items: center; margin-bottom: 16px; }
.brand .avatar { width: 58px; height: 58px; border-radius: 50%; box-shadow: var(--shadow-sm); overflow: hidden; }
.brand .avatar svg { display: block; }
.brand .brand-name { font-size: 13px; font-weight: 700; margin-top: 7px; color: var(--pink-ink); letter-spacing: .5px; }

.nav-list { display: flex; flex-direction: column; gap: 10px; width: 100%; align-items: center; overflow-y: auto; flex: 1; }
.nav-item {
  width: 84px;
  display: flex; flex-direction: column; align-items: center; gap: 5px;
  padding: 8px 4px; border-radius: 18px;
  transition: transform .18s, background .18s;
  position: relative;
}
.nav-item:hover { transform: translateY(-2px); }
.nav-item.active { background: #fff; box-shadow: var(--shadow-sm); }
.nav-item.active::before {
  content: ''; position: absolute; left: -8px; top: 22%; height: 56%; width: 4px;
  background: var(--pink-4); border-radius: 0 4px 4px 0;
}
.nav-item .bear { width: 54px; height: 54px; filter: drop-shadow(0 3px 5px rgba(190,160,150,.18)); }
.nav-item .nav-label { font-size: 12px; color: var(--ink-2); font-weight: 600; white-space: nowrap; }
.nav-item.active .nav-label { color: var(--pink-ink); }

.sidebar-foot { margin-top: auto; padding-top: 10px; }
.icon-btn {
  width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center;
  background: #fff; box-shadow: var(--shadow-sm); font-size: 16px; color: var(--ink-2);
  transition: transform .15s;
}
.icon-btn:hover { transform: scale(1.06); }

.main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.topbar {
  height: 70px; flex: 0 0 70px; display: flex; align-items: center; justify-content: space-between;
  padding: 0 28px; border-bottom: 1px solid var(--line);
  background: rgba(255, 252, 249, .82); backdrop-filter: blur(10px);
}
.topbar .greeting { font-size: 18px; font-weight: 700; }
.topbar .greeting small { display: block; font-size: 12px; font-weight: 500; color: var(--ink-2); }
.topbar .date-chip { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-2); }
.topbar .date-chip b { color: var(--pink-ink); }

.view-container { flex: 1; overflow-y: auto; padding: 24px 28px 60px; scroll-behavior: smooth; }
.view { display: none; animation: fade .35s ease; max-width: 1180px; margin: 0 auto; }
.view.active { display: block; }
@keyframes fade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* ============ 通用组件 ============ */
.card {
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  padding: 20px; box-shadow: var(--shadow-sm);
}
.card + .card { margin-top: 16px; }
.card-title { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; margin: 0 0 14px; }
.card-title .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--pink-4); }
.section-head { display: flex; align-items: end; justify-content: space-between; margin-bottom: 18px; }
.section-head h2 { margin: 0; font-size: 22px; }
.section-head .sub { font-size: 12px; color: var(--ink-2); }

.grid { display: grid; gap: 16px; }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  padding: 9px 16px; border-radius: 12px; font-weight: 600; font-size: 13px;
  background: var(--pink-2); color: var(--ink); transition: transform .15s, filter .15s;
  white-space: nowrap;
}
.btn:hover { transform: translateY(-1px); filter: brightness(.98); }
.btn.primary { background: var(--pink-4); color: #fff; }
.btn.ghost { background: #fff; border: 1px solid var(--line); }
.btn.sm { padding: 6px 11px; font-size: 12px; border-radius: 10px; }
.btn.mini { padding: 4px 9px; font-size: 11px; border-radius: 9px; }

.input, .textarea, .select {
  width: 100%; border: 1px solid var(--line); background: #FFFCF9; border-radius: 12px;
  padding: 10px 12px; outline: none; transition: border .2s, box-shadow .2s;
}
.input:focus, .textarea:focus, .select:focus { border-color: var(--pink-3); box-shadow: 0 0 0 3px var(--pink-1); }
.textarea { resize: vertical; min-height: 90px; line-height: 1.7; }
.row { display: flex; gap: 10px; align-items: center; }
.row.wrap { flex-wrap: wrap; }
.spacer { flex: 1; }
.muted { color: var(--ink-2); }
.tiny { font-size: 12px; }
.empty { color: var(--ink-3); font-size: 13px; text-align: center; padding: 22px 0; }

.chip {
  display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: 999px;
  font-size: 12px; font-weight: 600; background: var(--pink-1); color: var(--pink-ink);
  border: 1px solid transparent; transition: all .2s; user-select: none;
}
.chip.clickable { cursor: pointer; }
.chip.clickable:hover { transform: translateY(-1px); }
.chip.on { background: var(--pink-4); color: #fff; }
.chip.holiday { background: #FDE8E6; color: #C07A76; }
.chip.ecom { background: var(--yellow); color: #A88437; }
.chip.plan { background: var(--blue); color: #5C8494; }
.chip.exam { background: var(--lavender); color: #85719B; }

/* ============ 首页 ============ */
.hero-quote {
  background: linear-gradient(135deg, var(--pink-1) 0%, #FFF7EE 100%);
  border: 1px solid #F6E2DC; border-radius: var(--radius); padding: 22px 24px; position: relative; overflow: hidden;
}
.hero-quote::after { content: '❝'; position: absolute; right: 18px; top: -16px; font-size: 90px; color: #F6DCD6; opacity: .6; }
.hero-quote .cn { font-size: 18px; font-weight: 700; line-height: 1.6; max-width: 82%; }
.hero-quote .en { font-size: 13px; color: var(--ink-2); margin-top: 8px; font-style: italic; max-width: 82%; }
.hero-quote .em { font-size: 22px; margin-left: 6px; }

.stat-card { text-align: center; padding: 18px 10px; }
.stat-card .ico { font-size: 26px; }
.stat-card .val { font-size: 26px; font-weight: 800; margin: 6px 0 2px; color: var(--ink); }
.stat-card .val small { font-size: 13px; font-weight: 600; color: var(--ink-2); }
.stat-card .lbl { font-size: 12px; color: var(--ink-2); }
.stat-card .sub { font-size: 11px; color: var(--ink-3); margin-top: 4px; }

.checkin-btn {
  width: 100%; padding: 12px; border-radius: 14px; font-weight: 700; font-size: 14px;
  background: #F4EEE9; color: var(--ink-2); transition: all .25s;
}
.checkin-btn.done { background: var(--green-2); color: #3E6B3A; }

.cups { display: flex; gap: 3px; flex-wrap: nowrap; justify-content: center; }
.cup { cursor: pointer; transition: transform .18s; }
.cup:hover { transform: translateY(-3px); }

.progress-ring { display: flex; align-items: center; justify-content: center; gap: 14px; }
.ring { width: 82px; height: 82px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 18px; }

.today-list { list-style: none; padding: 0; margin: 0; }
.today-list li { display: flex; gap: 10px; align-items: flex-start; padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: 14px; }
.today-list li:last-child { border-bottom: none; }
.today-list .tag { flex: 0 0 auto; font-size: 11px; padding: 2px 7px; border-radius: 8px; font-weight: 700; }

/* ============ 待办清单 ============ */
.todo-input-row { display: flex; gap: 10px; margin-bottom: 14px; }
.todo-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.todo-item {
  display: flex; align-items: center; gap: 11px; padding: 11px 12px; border-radius: 14px;
  background: #FFFCF9; border: 1px solid var(--line); transition: box-shadow .2s, opacity .2s, transform .15s;
}
.todo-item:hover { box-shadow: var(--shadow-sm); }
.todo-item.done { opacity: .55; }
.todo-item.done .todo-text { text-decoration: line-through; }
.todo-item.dragging { opacity: .4; }
.todo-item.drop-target { border-color: var(--pink-4); box-shadow: 0 0 0 2px var(--pink-2); }
.todo-check {
  flex: 0 0 22px; width: 22px; height: 22px; border-radius: 7px; border: 2px solid var(--pink-3);
  display: grid; place-items: center; font-size: 14px; color: #fff; transition: all .2s;
}
.todo-check.checked { background: var(--green-2); border-color: var(--green-2); }
.todo-text { flex: 1; word-break: break-word; }
.todo-handle { cursor: grab; color: var(--ink-3); font-size: 16px; padding: 0 4px; touch-action: none; user-select: none; }
.todo-handle:active { cursor: grabbing; }
.todo-del { color: var(--ink-3); font-size: 15px; opacity: 0; transition: opacity .2s; }
.todo-item:hover .todo-del { opacity: 1; }

/* ============ 日历 / 日程 ============ */
.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.cal-head .title { font-size: 19px; font-weight: 800; }
.cal-nav { display: flex; gap: 8px; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
.cal-dow { text-align: center; font-size: 12px; color: var(--ink-2); padding: 4px 0 8px; font-weight: 600; }
.cal-cell {
  min-height: 74px; border-radius: 12px; padding: 7px; background: #FFFCF9; border: 1px solid var(--line);
  cursor: pointer; transition: all .18s; position: relative; display: flex; flex-direction: column; gap: 3px;
}
.cal-cell:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
.cal-cell.other { opacity: .38; }
.cal-cell.today { border-color: var(--pink-4); background: #FFF5F2; }
.cal-cell.selected { box-shadow: 0 0 0 2px var(--pink-4); }
.cal-cell .dnum { font-size: 13px; font-weight: 700; }
.cal-cell .dnum.period-day { color: #D58286; }
.cal-cell .dots { display: flex; gap: 3px; flex-wrap: wrap; margin-top: auto; }
.cal-cell .dot-mark { width: 7px; height: 7px; border-radius: 50%; }
.dot-holiday { background: #EFA9A5; }
.dot-ecom { background: #E7C46B; }
.dot-plan { background: #9CC4D3; }
.dot-exam { background: #BCA6D4; }
.dot-period { background: #F2AFB2; }
.cal-legend { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 12px; font-size: 12px; color: var(--ink-2); }
.cal-legend span { display: inline-flex; align-items: center; gap: 5px; }
.cal-legend i { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }

.plan-tabs { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
.tab {
  padding: 7px 16px; border-radius: 999px; background: #F6EFE9; color: var(--ink-2); font-weight: 600; font-size: 13px;
  transition: all .2s;
}
.tab.active { background: var(--pink-4); color: #fff; }
.plan-row { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 12px; background: #FFFCF9; border: 1px solid var(--line); margin-bottom: 8px; }
.plan-row .bar { width: 4px; height: 20px; border-radius: 3px; flex: 0 0 4px; }
.plan-row .txt { flex: 1; }
.plan-row.done .txt { text-decoration: line-through; opacity: .5; }

/* ============ 健康 ============ */
.health-input-grid { display: grid; grid-template-columns: 100px 1fr; gap: 10px; align-items: center; margin-bottom: 10px; }
.health-input-grid .input { margin: 0; }
.water-big { display: flex; align-items: center; justify-content: center; gap: 5px; flex-wrap: wrap; padding: 8px 0; }
.water-total { text-align: center; font-size: 13px; color: var(--ink-2); margin-top: 6px; }
.water-total b { font-size: 20px; color: var(--blue-2); }
.sup-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.sup-item {
  padding: 12px 6px; border-radius: 14px; text-align: center; background: #F8F3EE; border: 1px solid var(--line);
  font-size: 12px; font-weight: 600; cursor: pointer; transition: all .2s; user-select: none;
}
.sup-item:hover { transform: translateY(-2px); }
.sup-item.on { background: var(--green-2); color: #2F5C2C; border-color: var(--green-2); }
.sup-item .em { display: block; font-size: 20px; margin-bottom: 4px; }

.big-metric { text-align: center; padding: 16px 8px; background: linear-gradient(160deg, var(--pink-1), #FFF7F2); border-radius: 18px; }
.big-metric .num { font-size: 42px; font-weight: 800; color: var(--pink-ink); line-height: 1.1; }
.big-metric .unit { font-size: 14px; color: var(--ink-2); }

/* ============ 英语 ============ */
.eng-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
.article-box { background: #FFFDF9; border: 1px solid var(--line); border-radius: 16px; padding: 18px; line-height: 1.9; }
.article-box h3 { margin: 0 0 10px; font-size: 16px; }
.article-en { font-size: 15px; }
.article-cn { font-size: 13px; color: var(--ink-2); margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--line); display: none; }
.article-cn.show { display: block; }
.word-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.word-table th, .word-table td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); }
.word-table th { color: var(--ink-2); font-size: 12px; background: #FBF5F0; }
.word-table tr:hover td { background: #FFF8F4; }
.word-en { font-weight: 700; }
.word-play { cursor: pointer; color: var(--pink-ink); }

.quiz-q { padding: 14px 0; border-bottom: 1px dashed var(--line); }
.quiz-q:last-child { border-bottom: none; }
.quiz-q .qtext { font-weight: 600; margin-bottom: 10px; }
.quiz-opt { display: block; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--line); margin-bottom: 7px; cursor: pointer; transition: all .18s; }
.quiz-opt:hover { background: var(--pink-1); }
.quiz-opt.selected { background: var(--pink-2); border-color: var(--pink-4); }
.quiz-opt.correct { background: var(--green-2); border-color: var(--green-2); }
.quiz-opt.wrong { background: #F8D4D2; border-color: #E4ABA7; }

.result-card { border-radius: 16px; padding: 18px; margin-top: 16px; }
.result-card.good { background: var(--green); }
.result-card.bad { background: var(--pink-1); }
.analysis { background: #FFFCF9; border-radius: 12px; padding: 14px; margin-top: 12px; font-size: 13px; line-height: 1.8; }

.timer-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 13px; border-radius: 999px; background: var(--lavender); color: #6E5A87; font-weight: 700; font-size: 13px; }

.flashcard {
  background: linear-gradient(145deg, #FFF9F3, #FDEFE9); border: 1px solid var(--line); border-radius: 18px;
  padding: 36px 20px; text-align: center; min-height: 170px; display: flex; flex-direction: column;
  align-items: center; justify-content: center; cursor: pointer; transition: transform .2s;
}
.flashcard:hover { transform: translateY(-3px); }
.flashcard .big { font-size: 26px; font-weight: 800; }
.flashcard .hint { font-size: 12px; color: var(--ink-2); margin-top: 12px; }

.mic-btn { width: 74px; height: 74px; border-radius: 50%; background: var(--pink-4); color: #fff; font-size: 28px; display: grid; place-items: center; margin: 0 auto; box-shadow: 0 6px 18px rgba(228,171,167,.4); transition: transform .18s; }
.mic-btn:hover { transform: scale(1.06); }
.mic-btn.recording { background: #E07B77; animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(224,123,119,.5); } 50% { box-shadow: 0 0 0 16px rgba(224,123,119,0); } }

/* ============ 树洞小记 ============ */
.diary-layout { display: grid; grid-template-columns: 240px 1fr; gap: 20px; }
.diary-sidelist { max-height: 70vh; overflow-y: auto; }
.diary-entry-mini { padding: 10px 12px; border-radius: 12px; cursor: pointer; transition: all .18s; margin-bottom: 7px; border: 1px solid var(--line); background: #FFFCF9; }
.diary-entry-mini:hover { transform: translateX(3px); }
.diary-entry-mini.active { background: var(--pink-1); border-color: var(--pink-3); }
.diary-entry-mini .d { font-weight: 700; font-size: 13px; }
.diary-entry-mini .p { font-size: 11px; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.paper {
  position: relative; border-radius: 10px; padding: 34px 32px 30px; min-height: 460px;
  box-shadow: var(--shadow); overflow: hidden;
  background-color: #FFFCF6;
}
.paper::before {
  content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .5;
}
.paper .tape {
  position: absolute; top: -10px; left: 50%; transform: translateX(-50%) rotate(-3deg);
  width: 92px; height: 26px; background: rgba(238, 200, 190, .65); border-radius: 2px; box-shadow: 0 2px 5px rgba(0,0,0,.06);
}
.paper .paper-date { font-family: var(--font-hand); font-size: 22px; font-weight: 700; margin-bottom: 6px; position: relative; }
.paper .paper-meta { font-size: 12px; color: var(--ink-2); margin-bottom: 18px; position: relative; }
.paper .paper-lines { position: absolute; inset: 92px 28px 30px; pointer-events: none; }
.paper .paper-lines i { display: block; height: 32px; border-bottom: 1px dashed rgba(150,130,120,.22); }
.paper textarea {
  position: relative; width: 100%; min-height: 330px; border: none; outline: none; resize: none;
  background: transparent; font-family: var(--font-hand); font-size: 20px; line-height: 32px; color: #4A403B;
  z-index: 2;
}
.mood-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; position: relative; z-index: 2; }
.mood-chip { padding: 5px 12px; border-radius: 999px; background: rgba(255,255,255,.66); border: 1px solid var(--line); font-size: 13px; cursor: pointer; transition: all .2s; }
.mood-chip.on { background: var(--pink-3); color: #fff; border-color: var(--pink-3); }
.saved-hint { position: absolute; right: 26px; bottom: 16px; font-size: 11px; color: var(--ink-3); }

/* 每日信纸图案：8 套低饱和配色，风格统一自然文艺 */
.paper-style-0 { --pl: #F7E7DE; background-image: radial-gradient(#EBC9BC 1px, transparent 1px); background-size: 18px 18px; }
.paper-style-1 { --pl: #E7EFE3; background-image: linear-gradient(90deg, rgba(160,190,150,.14) 1px, transparent 1px); background-size: 26px 100%; }
.paper-style-2 { --pl: #F5EEDD; background-image: radial-gradient(#DFCFA6 1px, transparent 1px); background-size: 22px 22px; }
.paper-style-3 { --pl: #E5EDF0; background-image: repeating-linear-gradient(45deg, rgba(150,180,195,.10) 0 2px, transparent 2px 12px); }
.paper-style-4 { --pl: #F3E4E8; background-image: radial-gradient(#DDBEC7 1px, transparent 1px); background-size: 16px 16px; }
.paper-style-5 { --pl: #EFE9E1; background-image: linear-gradient(rgba(180,160,140,.12) 1px, transparent 1px); background-size: 100% 24px; }
.paper-style-6 { --pl: #E9EFE6; background-image: radial-gradient(#BFD3B4 1.5px, transparent 1.5px); background-size: 28px 28px; }
.paper-style-7 { --pl: #F7EBE4; background-image: repeating-linear-gradient(-45deg, rgba(220,180,160,.10) 0 2px, transparent 2px 14px); }

/* ============ 弹窗 / 提示 ============ */
.modal-mask { position: fixed; inset: 0; background: rgba(90,79,74,.28); backdrop-filter: blur(3px); display: grid; place-items: center; z-index: 100; }
.modal { background: var(--surface); border-radius: 22px; padding: 24px; width: min(440px, 92vw); box-shadow: var(--shadow); max-height: 86vh; overflow-y: auto; }
.modal h3 { margin: 0 0 14px; }
.toast {
  position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(20px);
  background: var(--ink); color: #fff; padding: 11px 20px; border-radius: 999px; font-size: 13px;
  opacity: 0; pointer-events: none; transition: all .3s; z-index: 200;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ============ 响应式：窄屏变底部导航 ============ */
@media (max-width: 820px) {
  body { overflow: auto; }
  #app { flex-direction: column; height: 100dvh; }
  .sidebar {
    order: 2; width: 100%; flex: 0 0 auto; flex-direction: row; padding: 6px 4px;
    border-right: none; border-top: 1px solid var(--line); position: fixed; bottom: 0; left: 0; right: 0; z-index: 50;
  }
  .brand, .sidebar-foot { display: none; }
  .nav-list { flex-direction: row; justify-content: space-around; gap: 0; overflow: visible; }
  .nav-item { width: auto; flex: 1; padding: 4px 2px; }
  .nav-item.active::before { display: none; }
  .nav-item .bear { width: 42px; height: 42px; }
  .nav-item .nav-label { font-size: 10px; }
  .main { order: 1; }
  .topbar { padding: 0 16px; height: 60px; flex-basis: 60px; }
  .topbar .greeting { font-size: 16px; }
  .view-container { padding: 16px 14px 90px; }
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
  .diary-layout { grid-template-columns: 1fr; }
  .diary-sidelist { max-height: 180px; display: flex; gap: 8px; overflow-x: auto; }
  .diary-entry-mini { flex: 0 0 130px; }
  .sup-grid { grid-template-columns: repeat(4, 1fr); }
}
@media (max-width: 480px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .cal-cell { min-height: 60px; padding: 4px; }
  .cal-cell .dnum { font-size: 11px; }
  .sup-grid { grid-template-columns: repeat(2, 1fr); }
  .paper { padding: 26px 18px; }
  .hero-quote .cn { font-size: 16px; max-width: 100%; }
  .hero-quote .en { max-width: 100%; }
}
